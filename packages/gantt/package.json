{
  "name": "@quartzio/gantt",
  "version": "0.0.0",
  "description": "Headless Gantt chart engine in TypeScript: scheduling in working time, dependencies, calendars, layout, drag and drop and undo, with no dependencies and no DOM",
  "license": "MIT",
  "author": {
    "name": "Sindre Glomnes",
    "url": "https://github.com/Sindreglo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sindreglo/quartzio.git",
    "directory": "packages/gantt"
  },
  "homepage": "https://github.com/Sindreglo/quartzio/tree/main/packages/gantt#readme",
  "bugs": {
    "url": "https://github.com/Sindreglo/quartzio/issues"
  },
  "keywords": [
    "gantt",
    "gantt-chart",
    "headless",
    "scheduling",
    "project-management",
    "project-planning",
    "timeline",
    "dependencies",
    "calendar",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@quartzio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@quartzio/source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": {
        "default": "./dist/styles.css"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "API.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
