{
  "name": "@quartzio/gantt-react",
  "version": "0.1.0",
  "description": "React Gantt chart component: task list and timeline with scheduling, dependencies, working-time calendars, drag and drop, editing and undo",
  "license": "MIT",
  "author": {
    "name": "Sindre Glomnes",
    "url": "https://github.com/Sindreglo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sindreglo/quartzio.git",
    "directory": "packages/gantt-react"
  },
  "homepage": "https://github.com/Sindreglo/quartzio/tree/main/packages/gantt-react#readme",
  "bugs": {
    "url": "https://github.com/Sindreglo/quartzio/issues"
  },
  "keywords": [
    "gantt",
    "gantt-chart",
    "react",
    "react-component",
    "scheduling",
    "project-management",
    "project-planning",
    "timeline",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@quartzio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@quartzio/source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": {
        "default": "./dist/styles.css"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@quartzio/gantt": "workspace:^",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@quartzio/gantt": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
