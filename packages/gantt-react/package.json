{
  "name": "@quartzio/gantt-react",
  "version": "0.0.0",
  "description": "React Gantt chart component built on @quartzio/gantt",
  "license": "MIT",
  "author": "Sindre Glomnes",
  "keywords": [
    "gantt",
    "gantt-chart",
    "react",
    "react-component",
    "scheduling",
    "timeline"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@quartzio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@quartzio/source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@quartzio/gantt": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
