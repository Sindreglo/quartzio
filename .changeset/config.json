{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "baseBranch": "main",
  "access": "public",
  "fixed": [["@quartzio/*"]],
  "updateInternalDependencies": "patch",
  "commit": false,
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "Sindreglo/quartzio"
    }
  ],
  "changedFilePatterns": ["src/**", "!src/**/*.test.{ts,tsx}", "package.json", "README.md"]
}
